#!/usr/bin/env bash
set -u

DEFAULT_REPO="/Users/testadmin/Documents/Codex/2026-06-16/please-download-this-nvidia-skillspector-https/SkillSpector"
REPO="${SKILLSPECTOR_REPO:-$DEFAULT_REPO}"

if [[ ! -d "$REPO" ]]; then
  if command -v skillspector >/dev/null 2>&1; then
    exec skillspector scan "$@"
  fi
  echo "SkillSpector repo not found: $REPO" >&2
  echo "Set SKILLSPECTOR_REPO=/path/to/SkillSpector or install the skillspector CLI." >&2
  exit 2
fi

if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="$REPO/src:$PYTHONPATH"
else
  export PYTHONPATH="$REPO/src"
fi

if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$REPO" python -m skillspector.cli scan "$@"
fi

if [[ -x "$REPO/.venv/bin/python" ]]; then
  exec "$REPO/.venv/bin/python" -m skillspector.cli scan "$@"
fi

echo "uv is not installed and no local SkillSpector venv Python exists at $REPO/.venv/bin/python" >&2
echo "Install uv or create a venv in the SkillSpector repo and run make install." >&2
exit 2
